# ================================================================
# Libra — Environment Variables Template
# ================================================================
# Copy this file to .env and fill in your values.
# All keys marked (required) must be set for the feature to work.
# ================================================================

# ── Supabase (required) ──────────────────────────────────────────
# Project Settings → API → Project URL + anon public key
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Resend (required for donation emails) ────────────────────────
# resend.com → API Keys → Sending access only
RESEND_API_KEY=your_resend_api_key

# ── Web Push / VAPID (optional — for streak notifications) ───────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# ── Stripe (optional — for webhook verification) ─────────────────
# Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=

# ── Supabase Service Role (required for push cron) ───────────────
# Project Settings → API → service_role key (NEVER expose in frontend)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Vercel Cron Secret (required for cron security) ─────────────
# Any random string — add to Vercel env vars
CRON_SECRET=your_random_secret_string
