{
  "github": {
    "enabled": true,
    "autoAlias": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "connect-src 'self' https://openlibrary.org https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://covers.openlibrary.org"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-claude-key" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/streak-reminder",
      "schedule": "0 18 * * *"
    }
  ]
}
